{
  "builds": [
    {
      "src": "deploy/vercel/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "api/**",
          "pipeline/**",
          "data/*.parquet",
          "data/*.json",
          "deploy/vercel/*.py",
          "deploy/vercel/regions.json",
          "deploy/vercel/_vendor/**",
          "deploy/vercel/regions.geojson",
          "deploy/vercel/_site/**"
        ],
        "excludeFiles": "{data/regions/**,web/**,tests/**,data/backup*/**,data/logs/**,deploy/vercel/regions_tmp/**,**/__pycache__/**}"
      }
    },
    {
      "src": "data/regions/*/fields.parquet",
      "use": "@vercel/static"
    },
    {
      "src": "data/regions/*/field_traits.parquet",
      "use": "@vercel/static"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(/.*)?",
      "dest": "/deploy/vercel/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
