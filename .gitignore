# data is rebuilt by the pipeline (downloads are cached in data/raw)
# data is rebuilt by the pipeline (downloads are cached in data/raw), but the small finished tables the
# app needs are tracked so a fresh clone works. Raw downloads, logs and scratch files stay out.
/data/*
!/data/*.parquet
!/data/effects.json
!/data/soil_health_meta.json
!/data/fields_provenance.json
!/data/regions/
/data/regions/*/raw/
/data/soil_bare_obs*.parquet
/data/soil_health_proto*
/data/fields_fake.parquet

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# node
node_modules/
/web/dist/
*.tsbuildinfo

# misc
.DS_Store
*.log

# local secrets (API keys); never commit
.env
.env.*
!.env.example
.vercel
